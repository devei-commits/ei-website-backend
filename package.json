{
  "name": "nodejs_express_postgres_orders",
  "version": "1.0.0",
  "description": "Order REST API using NodeJS, Express, Postgresql",
  "main": "app.js",
  "scripts": {
    "test": "jest",
    "test:math": "cross-env NODE_ENV=test jest -- test/unit test/integration",
    "start": "node app.js",
    "dev": "nodemon -L app.js",
    "seed": "node seed.js",
    "seed:admins": "node scripts/seed-admin-users.js",
    "seed:facility": "node scripts/seed-facility-structure.js",
    "clean-data": "node cleanData.js --yes",
    "reset-order-lifecycle": "node scripts/reset-order-lifecycle.js",
    "reset-order-lifecycle:yes": "node scripts/reset-order-lifecycle.js --yes",
    "zoho:import:items": "node scripts/zoho-pull-items-to-products.js",
    "zoho:import:customers-to-users": "node scripts/zoho-pull-customers-to-users.js",
    "zoho:import:customers-to-clients": "node scripts/zoho-pull-customers-to-clients.js",
    "zoho:import:vendors-to-vendor-clients": "node scripts/zoho-pull-vendors-to-vendor-clients.js",
    "zoho:import:invoices-to-fulfillment-invoices": "node scripts/zoho-pull-invoices-to-fulfillment-invoices.js",
    "zoho:import:salesorders": "node scripts/zoho-pull-salesorders-to-sales-orders.js",
    "export:products-sample": "node scripts/export-products-with-bom.js --limit 10",
    "import:product-mrp-bom": "node scripts/import-product-mrp-from-bom-price-list.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:runtime": "pm2-runtime start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ei-backend",
    "pm2:delete": "pm2 delete ei-backend",
    "pm2:logs": "pm2 logs ei-backend",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "prepare": "husky"
  },
  "author": "dhrv",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "mailtrap": "^4.4.0",
    "multer": "^2.1.1",
    "pg": "^8.13.1",
    "pm2": "^6.0.14",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2"
  }
}
