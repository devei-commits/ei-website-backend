PORT=

# Postgres (used by db.js via DATABASE_URL)
# Local host settings (when running node directly on your machine)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
# Local connection string (overridden inside Docker compose for the app service)
DATABASE_URL=

# JWT secrets (CHANGE THESE FOR PRODUCTION)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Razorpay (fill with your real keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

