PORT=

# Optional: comma-separated extra browser origins for CORS (e.g. https://admin.yourdomain.com).
# Defaults include localhost:5173/5174, 127.0.0.1, ei-admin + esthetic-insights Vercel production and preview URLs.
CORS_ALLOWED_ORIGINS=

# DEV=true: skip OTP for client1@example.com and return token on login (no Mailtrap needed)
DEV=

# Postgres (used by db.js via DATABASE_URL)
# Local host settings (when running node directly on your machine)
# Prefer a non-obvious database name (e.g. ei_pg_ + 16 hex chars) instead of words like orders_db.
POSTGRES_DB=
# Non-obvious role name (e.g. ei_u_ + hex). Docker Compose requires POSTGRES_PASSWORD to be set (no default in compose).
POSTGRES_USER=
# Required for docker compose up: generate e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
# Connection string for Sequelize. In Docker, use host `db` (compose service name). Compose does not
# rebuild DATABASE_URL from POSTGRES_* — set the full URL here. App container uses this file via env_file.
DATABASE_URL=

# Redis (API list-cache / cache-aside). Docker Compose sets redis://redis:6379 on the app service.
# Run Node on host against compose Redis: redis://127.0.0.1:6379 (see REDIS_PORT in compose)
REDIS_URL=

# JWT (recommended): per-user HMAC secret = PREFIX + userId + SUFFIX. Both PREFIX and SUFFIX required for this mode.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  (run twice per token type)
ACCESS_TOKEN_SECRET_PREFIX=
ACCESS_TOKEN_SECRET_SUFFIX=
REFRESH_TOKEN_SECRET_PREFIX=
REFRESH_TOKEN_SECRET_SUFFIX=
# Optional legacy (single static secret) if PREFIX/SUFFIX are unset — not used when both halves are set.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Razorpay (fill with your real keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mailtrap (OTP emails). Get token from Mailtrap → Sending Domains / API Tokens
MAIL_TOKEN=
SENDER_MAIL=

# Zoho Books (India DC): backend sync scope
# - Users -> Zoho contacts (controlled by ZOHO_SYNC_CONTACTS + ZOHO_SYNC_USERTYPES)
# - RM/PM -> Zoho items (controlled by ZOHO_SYNC_ITEMS)
# - Invoices -> Zoho invoices (controlled by ZOHO_SYNC_INVOICES)
# Set ZOHO_BOOKS_ENABLED=true after filling OAuth + org + default currency id from Zoho Books.
ZOHO_BOOKS_ENABLED=false
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_BOOKS_API_BASE=https://www.zohoapis.in/books/v3
ZOHO_ACCOUNTS_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=http://localhost
# Must be a currency_id from YOUR org (not from Zoho samples). Run: node scripts/list-zoho-currencies.js
# Use the full decimal string (e.g. 3529895000000000064); do not shorten — JS cannot store this as a number safely.
ZOHO_DEFAULT_CURRENCY_ID=
ZOHO_DEFAULT_PAYMENT_TERMS=15
# Master toggle for contact sync flows (users + vendor/client contact pushes used by seed)
ZOHO_SYNC_CONTACTS=true
# Comma-separated role_code values (e.g. customer,doctor) that trigger Zoho contact create
ZOHO_SYNC_USERTYPES=customer,doctor
# Seconds before access_token expiry to refresh (default 120). Zoho sets expires_in in the token response; we honor it.
# ZOHO_REFRESH_TOKEN in .env stays the same across refreshes unless Zoho rotates it (then update .env once).
ZOHO_TOKEN_EXPIRY_BUFFER_SEC=120
# Verbose logs: full request URL + JSON body + response for Books API calls (oauth response masks tokens). ZOHO_LOG_API=true is an alias.
ZOHO_DEBUG=false

# Zoho Books: POST /items when a product is created (stores item_id on products.zoho_item_id)
ZOHO_SYNC_ITEMS=true
# Optional: default sales tax id from Zoho Books → Settings → Taxes (id from Zoho; long ids: paste full string)
ZOHO_DEFAULT_ITEM_TAX_ID=

# Zoho Books: POST /invoices when fulfillment invoice is created (POST /fulfillment/invoices or PATCH .../invoice)
ZOHO_SYNC_INVOICES=true
# Optional: multi-location org — location id for invoice + line items
ZOHO_DEFAULT_LOCATION_ID=
# Zoho Inventory API (locations/warehouses sync for Facility Management). Uses same OAuth token.
# ZOHO_INVENTORY_API_BASE=https://www.zohoapis.in/inventory/v1
# ZOHO_INVENTORY_ORGANIZATION_ID=   # defaults to ZOHO_BOOKS_ORGANIZATION_ID when unset
# Invoice line tax (GST); falls back to ZOHO_DEFAULT_ITEM_TAX_ID if unset
ZOHO_DEFAULT_LINE_TAX_ID=
ZOHO_DEFAULT_TDS_TAX_ID=
# If POST /invoices fails with "Invalid Element gst_treatment", set true (skip gst_treatment, place_of_supply, gst_no on payload).
ZOHO_INVOICE_OMIT_GST_FIELDS=false
# India GST (only when OMIT is false). Examples: consumer, business_gst, business_none, overseas — must match customer setup in Books.
ZOHO_INVOICE_GST_TREATMENT=
ZOHO_INVOICE_PLACE_OF_SUPPLY=
# Org GSTIN for sales invoices (if required by your Zoho org)
ZOHO_INVOICE_GST_NO=
# If website user / VendorClient has no zoho id, optional fallback contact id (dev only)
ZOHO_FALLBACK_CUSTOMER_ID=

# --- node seed.js only (opt-in; leave false for normal re-seeds so Books API is not called every time) ---
# Requires ZOHO_BOOKS_ENABLED=true and valid OAuth/org/ZOHO_DEFAULT_CURRENCY_ID.
# One switch: sync FG/RM/PM items + contacts to Zoho and Postgres, then POST demo invoice using those DB ids.
ZOHO_SEED_FULL_SYNC=false
# Optional granular overrides (used when ZOHO_SEED_FULL_SYNC=false):
ZOHO_SEED_SYNC_ITEMS=false
ZOHO_SEED_SYNC_CONTACT=false
ZOHO_SEED_SYNC_INVOICE=false

