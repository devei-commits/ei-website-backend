PORT=

# DEV=true: skip OTP for client1@example.com and return token on login (no Mailtrap needed)
DEV=

# Postgres (used by db.js via DATABASE_URL)
# Local host settings (when running node directly on your machine)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
# Local connection string (overridden inside Docker compose for the app service)
DATABASE_URL=

# JWT secrets (CHANGE THESE FOR PRODUCTION)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Razorpay (fill with your real keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mailtrap (OTP emails). Get token from Mailtrap → Sending Domains / API Tokens
MAIL_TOKEN=
SENDER_MAIL=

