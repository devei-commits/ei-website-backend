Table "enquiries" {
  "enquiry_id" int4 [pk, not null, increment]
  "ticket_number" varchar(32) [unique]
  "user_id" int4
  "customer" json [note: '{ id?, name, email, phone?, company?, isRegistered }']
  "subject" varchar(500)
  "description" text
  "category" varchar(80)
  "priority" varchar(40) [default: 'medium']
  "status" varchar(40) [default: 'new']
  "source" varchar(40)
  "ticket_scope" varchar(20) [default: 'customer']
  "collaboration" json
  "tags" json
  "current_assignee" json [note: '{ staffId, staffName, staffEmail, department, assignedAt, assignedBy, isActive }']
  "assignment_history" json
  "linked_orders" json [note: '[{ orderId, orderNumber, orderDate, orderStatus, orderTotal, productName, linkedAt, linkedBy, relevance }]']
  "messages" json [note: '[{ id, ticketId, senderId, senderName, senderType, content, sentAt, isInternal }]']
  "activities" json [note: '[{ id, ticketId, type, description, performedBy, timestamp, previousValue?, newValue? }]']
  "first_response_at" timestamptz
  "sla_deadline" timestamptz
  "resolved_at" timestamptz
  "resolution_notes" text
  "response_count" int4 [default: 0]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz
  "enquiry_type" varchar(255)
  "details" json
}

